{
  "name": "Ile Itura - Lapsed Booking Notifier",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days"
            }
          ]
        }
      },
      "id": "e3a890db-3b17-43c3-b924-d2e5a5135111",
      "name": "Daily Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        220,
        280
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, booking_ref, guest_name, guest_phone, guest_email FROM bookings WHERE grace_period_expires_at < NOW() AND status = 'pending';"
      },
      "id": "3b17f511-2e6f-4d92-ae31-318e8741b2a9",
      "name": "Find Expired Bookings",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        440,
        280
      ],
      "credentials": {
        "postgres": {
          "id": "YOUR_SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE bookings SET status = 'cancelled' WHERE id = '{{$json.id}}';"
      },
      "id": "e932b12a-412d-4589-9a72-db3e1571bc88",
      "name": "Update to Cancelled",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        680,
        280
      ],
      "credentials": {
        "postgres": {
          "id": "YOUR_SUPABASE_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "ileituraogunbadewa@yahoo.com",
        "toEmail": "={{$json.guest_email}}",
        "subject": "Booking Grace Period Expired - Ile Itura",
        "html": "Dear {{$json.guest_name}},<br><br>Your booking grace period for Ile Itura Ogunbadewa has expired. Per our policy, the booking token is non-refundable as the 30-day window has closed.<br><br>Your booking reference was: {{$json.booking_ref}}.<br><br>If you have any questions, please reply to this email or contact us on WhatsApp."
      },
      "id": "5f1a941e-3f82-4112-92f7-f1e1a49f8721",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        920,
        180
      ],
      "credentials": {
        "smtp": {
          "id": "YOUR_SMTP_CREDENTIAL_ID",
          "name": "SMTP"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsappApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{$json.guest_phone.replace('+', '')}}"
            },
            {
              "name": "type",
              "value": "template"
            },
            {
              "name": "template",
              "value": "{\"name\": \"booking_lapsed\", \"language\": {\"code\": \"en\"}}"
            }
          ]
        }
      },
      "id": "8a72b123-1d8f-4e9a-9e12-c1a9f1b2c3d4",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        920,
        380
      ],
      "credentials": {
        "whatsappApi": {
          "id": "YOUR_WHATSAPP_CREDENTIAL_ID",
          "name": "WhatsApp API"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Daily Trigger": {
      "main": [
        [
          {
            "node": "Find Expired Bookings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Expired Bookings": {
      "main": [
        [
          {
            "node": "Update to Cancelled",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update to Cancelled": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "f7ab0e9a-1c8a-49a3-8392-7fca01d1c1a9"
}
